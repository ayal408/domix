# Local-dev value. docker-compose.yml overrides this to Host=postgres
# automatically when the stack runs via `docker compose up` — no manual edit
# needed to switch between local and containerized runs.
DEFAULT_CONNECTION=Host=localhost;Database=domixdb;Username=postgres;Password=yourpassword
JWT_SECRET=THI_SHOULD_BE_A_VERY_LONG_RANDOM_STRING_MIN_32_CHARS
GMAIL__EMAIL=your_email@gmail.com
GMAIL__CLIENTID=your_client_id
GMAIL__CLIENTSECRET=your_client_secret
GMAIL__REFRESHTOKEN=your_refresh_token
GEMINI_API_KEY=your_gemini_api_key
# Public URL of domix-client, used to build the link in verification/reset emails.
# Via `docker compose up` (nginx-gateway serves the SPA on NGINX_PORT, default 80):
#   CLIENT_APP_URL=http://localhost
# Via `npm run dev` (Vite dev server) instead:
#   CLIENT_APP_URL=http://localhost:5173
CLIENT_APP_URL=http://localhost
# Where "Ask the team" chat escalations and support tickets are emailed. Leave empty to skip
# the notification email (tickets still land in the admin support inbox either way).
ADMIN_NOTIFICATION_EMAIL=
PORT=10000
# Local-dev value. docker-compose.yml overrides this to Host=postgres
# automatically when the stack runs via `docker compose up` — no manual edit
# needed to switch between local and containerized runs.
DEFAULT_CONNECTION=Host=localhost;Database=domixdb;Username=postgres;Password=yourpassword
JWT_SECRET=THI_SHOULD_BE_A_VERY_LONG_RANDOM_STRING_MIN_32_CHARS
GMAIL__EMAIL=your_email@gmail.com
GMAIL__CLIENTID=your_client_id
GMAIL__CLIENTSECRET=your_client_secret
GMAIL__REFRESH_TOKEN=your_refresh_token
PORT=10000
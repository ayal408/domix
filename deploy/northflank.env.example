# API service only: use the private PostgreSQL endpoint from Northflank's connection details.
DEFAULT_CONNECTION=Host=DATABASE_INTERNAL_HOST;Port=5432;Database=DATABASE_NAME;Username=DATABASE_USER;Password=DATABASE_PASSWORD
PORT=8080
ASPNETCORE_ENVIRONMENT=Production
CLIENT_APP_URL=https://YOUR_GATEWAY_HOST
RequireRemoteImageStorage=true
Cloudinary__CloudName=YOUR_CLOUD_NAME
Cloudinary__ApiKey=YOUR_API_KEY
Cloudinary__ApiSecret=YOUR_API_SECRET
# Use identical random values in API and gateway. Set them as runtime secrets only.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INTERNAL_SERVICE_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Gateway service only (in addition to the same JWT_SECRET and INTERNAL_SERVICE_KEY):
# DATA_SERVICE_URL=http://YOUR_API_INTERNAL_HOST:8080
# PORT=8080
# NODE_ENV=production
# COOKIE_SAME_SITE=strict

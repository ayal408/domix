PORT=5000
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# Local-dev value should be http://localhost:8080. docker-compose.yml
# overrides this to http://domix-server:8080 automatically when the stack
# runs via `docker compose up` — no manual edit needed to switch runners.
DATA_SERVICE_URL=http://localhost:8080
# Shared with domix-server's INTERNAL_SERVICE_KEY (must be the exact same value) — sent as
# X-Internal-Api-Key on every call to domix-server's internal-only endpoints.
INTERNAL_SERVICE_KEY=ANOTHER_VERY_LONG_RANDOM_STRING_MIN_32_CHARS_SHARED_WITH_AUTH_SERVER
REFRESH_TOKEN_EXPIRES=30d
ACCESS_TOKEN_EXPIRES=15m
JWT_AUDIENCE=serverApi
JWT_ISSUER=serverApi
GOOGLE_CLIENT_ID=
BCRYPT_SALT_ROUNDS=10
NODE_ENV=development
COOKIE_SAME_SITE=strict

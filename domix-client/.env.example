# ---------------------------------------------------------------------------
# DOMIX client environment. Copy to `.env` (or `.env.local`) and adjust.
# Every VITE_* value below is parsed and validated at boot by src/config/env.ts
# ---------------------------------------------------------------------------

# Base URL of the .NET data API (ApartmentAPI). Relative values go through the
# nginx gateway in production and through the Vite dev proxy locally.
VITE_API_URL=/api

# Base URL of the Express auth service (login / register / google / refresh).
VITE_AUTH_URL=/api/auth

# Public product name, shown in the shell and the document title.
VITE_APP_NAME=DOMIX

# Google Identity Services client id. Must match GOOGLE_CLIENT_ID on the
# auth-server, otherwise the ID token fails audience verification.
# Leave empty to hide the "Continue with Google" button entirely.
VITE_GOOGLE_CLIENT_ID=

# Set to "true" to mount the React Query devtools panel in development.
VITE_ENABLE_DEVTOOLS=false

# ---------------------------------------------------------------------------
# Dev-server-only proxy targets (not exposed to the browser bundle).
# Used by vite.config.ts to emulate the nginx gateway during `npm run dev`.
# ---------------------------------------------------------------------------
DEV_API_TARGET=http://localhost:8080
DEV_AUTH_TARGET=http://localhost:5000
